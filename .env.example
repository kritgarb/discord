# URL do webhook do canal de missões (Configurações do canal → Integrações → Webhooks)
DISCORD_WEBHOOK_URL=

# URL do webhook do canal do Compilado do Código Fonte TV
DISCORD_WEBHOOK_COMPILADO_URL=

# --- Bot de ponto (python -m ponto) ---
# Token do bot: Developer Portal → sua aplicação → Bot → Reset Token
PONTO_BOT_TOKEN=
# ID do servidor (clique direito no servidor → Copiar ID, com o Modo Desenvolvedor ligado).
# Com ele os comandos aparecem na hora; sem ele, a sincronização global pode levar até 1h.
PONTO_GUILD_ID=
# Manda DM lembrando quem está com o ponto aberto há mais de N horas (0 desliga)
PONTO_LEMBRETE_HORAS=8
# Nível de log: INFO (padrão) ou DEBUG para diagnosticar (mostra cada requisição ao Discord)
# PONTO_LOG_LEVEL=INFO
# Caminho do banco (no Docker já vem como /data/ponto.db)
# PONTO_DB=data/ponto.db
